{
  "info": {
    "name": "Omni IAM Interim APIs",
    "description": "19 unique interim IAM operations. Values are placeholders, not credentials. Gateway base URL: localhost:8080/internal-api/iam/v4.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/internal-api/iam/v4" },
    { "key": "iamAccessToken", "value": "{{set-from-local-login-response}}" }
  ],
  "item": [
    { "name": "Login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"Username\": \"{{userName}}\",\n  \"Password\": \"{{password}}\",\n  \"fiebaseId\": \"{{fiebaseId}}\",\n  \"appVersion\": \"1\",\n  \"osType\": \"iOS\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/Login" } },
    { "name": "TerminateProfile", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{iamAccessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"userName\": \"{{userName}}\",\n  \"userType\": \"Mobile\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/TerminateProfile" } },
    { "name": "OTPAuthRequest", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"verifyOtp\": \"{{registrationOtp}}\",\n  \"id\": \"{{registrationChallengeId}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/OTPAuthRequest" } },
    { "name": "refreshToken", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"UserName\": \"{{userName}}\",\n  \"refreshToken\": \"{{refreshToken}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/refreshToken" } },
    { "name": "ChangePassword", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{iamAccessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"UserName\": \"{{userName}}\",\n  \"Password\": \"{{currentPassword}}\",\n  \"NewPassword\": \"{{newPassword}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/ChangePassword" } },
    { "name": "ForgotPassword", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"verifyOtp\": \"{{recoveryOtp}}\",\n  \"newPassword\": \"{{newPassword}}\",\n  \"UserName\": \"{{userName}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/ForgotPassword" } },
    { "name": "LoginExternal", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"provider\": \"Apple\",\n  \"externalAccessToken\": \"{{providerAccessToken}}\",\n  \"externalAccessToken2\": \"{{providerAccessToken2}}\",\n  \"UserName\": \"{{userName}}\",\n  \"externalAccessEmail\": \"{{email}}\",\n  \"fiebaseId\": \"{{fiebaseId}}\",\n  \"appVersion\": \"1\",\n  \"osType\": \"iOS\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/LoginExternal" } },
    { "name": "OTPeBillAuthRequest", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{iamAccessToken}}" }], "url": { "raw": "{{baseUrl}}/OTPeBillAuthRequest?econtact={{econtact}}&otpCode={{workflowOtp}}", "host": ["{{baseUrl}}"], "path": ["OTPeBillAuthRequest"], "query": [{ "key": "econtact", "value": "{{econtact}}" }, { "key": "otpCode", "value": "{{workflowOtp}}" }] } } },
    { "name": "CallVoiceOTPRequest", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{iamAccessToken}}" }], "url": { "raw": "{{baseUrl}}/CallVoiceOTPRequest?telephoneNo={{telephoneNo}}", "host": ["{{baseUrl}}"], "path": ["CallVoiceOTPRequest"], "query": [{ "key": "telephoneNo", "value": "{{telephoneNo}}" }] } } },
    { "name": "AddAccountVoiceOTPRequest", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{iamAccessToken}}" }], "url": { "raw": "{{baseUrl}}/AddAccountVoiceOTPRequest?otpCode={{voiceOtp}}&econtact={{econtact}}", "host": ["{{baseUrl}}"], "path": ["AddAccountVoiceOTPRequest"], "query": [{ "key": "otpCode", "value": "{{voiceOtp}}" }, { "key": "econtact", "value": "{{econtact}}" }] } } },
    { "name": "ResendVoiceOTPRequest", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{iamAccessToken}}" }], "url": { "raw": "{{baseUrl}}/ResendVoiceOTPRequest?telephoneNo={{telephoneNo}}", "host": ["{{baseUrl}}"], "path": ["ResendVoiceOTPRequest"], "query": [{ "key": "telephoneNo", "value": "{{telephoneNo}}" }] } } },
    { "name": "SendOTPRequest", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{iamAccessToken}}" }], "url": { "raw": "{{baseUrl}}/SendOTPRequest?telephoneNo={{telephoneNo}}&requestType=eBill&requestPeriod=10&otpSource=MOBILE&otpContact={{otpContact}}", "host": ["{{baseUrl}}"], "path": ["SendOTPRequest"], "query": [{ "key": "telephoneNo", "value": "{{telephoneNo}}" }, { "key": "requestType", "value": "eBill" }, { "key": "requestPeriod", "value": "10" }, { "key": "otpSource", "value": "MOBILE" }, { "key": "otpContact", "value": "{{otpContact}}" }] } } },
    { "name": "VerifyOTPRequest", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{iamAccessToken}}" }], "url": { "raw": "{{baseUrl}}/VerifyOTPRequest?telephoneNo={{telephoneNo}}&requestType=eBill&otpCode={{workflowOtp}}&otpSource=MOBILE", "host": ["{{baseUrl}}"], "path": ["VerifyOTPRequest"], "query": [{ "key": "telephoneNo", "value": "{{telephoneNo}}" }, { "key": "requestType", "value": "eBill" }, { "key": "otpCode", "value": "{{workflowOtp}}" }, { "key": "otpSource", "value": "MOBILE" }] } } },
    { "name": "RegisterForBBFreedom", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{iamAccessToken}}" }], "url": { "raw": "{{baseUrl}}/RegisterForBBFreedom?tpNo={{tpNo}}&contactMobile={{contactMobile}}&description={{description}}", "host": ["{{baseUrl}}"], "path": ["RegisterForBBFreedom"], "query": [{ "key": "tpNo", "value": "{{tpNo}}" }, { "key": "contactMobile", "value": "{{contactMobile}}" }, { "key": "description", "value": "{{description}}" }] } } },
    { "name": "ChangeBBPassword", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{iamAccessToken}}" }], "url": { "raw": "{{baseUrl}}/ChangeBBPassword?subscriberID={{subscriberID}}&currentpass={{currentBroadbandPassword}}&newpass={{newBroadbandPassword}}", "host": ["{{baseUrl}}"], "path": ["ChangeBBPassword"], "query": [{ "key": "subscriberID", "value": "{{subscriberID}}" }, { "key": "currentpass", "value": "{{currentBroadbandPassword}}" }, { "key": "newpass", "value": "{{newBroadbandPassword}}" }] } } },
    { "name": "RegisterV2", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"userName\": \"{{userName}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/RegisterV2" } },
    { "name": "ResendOTPV2", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"UserName\": \"{{userName}}\",\n  \"userType\": \"Mobile\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/ResendOTPV2" } },
    { "name": "GetPeoTVGOAccessToken", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/GetPeoTVGOAccessToken?grant_type=authorization_code&code={{peoAuthorizationCode}}&client_id={{peoClientId}}&client_secret={{peoClientSecret}}", "host": ["{{baseUrl}}"], "path": ["GetPeoTVGOAccessToken"], "query": [{ "key": "grant_type", "value": "authorization_code" }, { "key": "code", "value": "{{peoAuthorizationCode}}" }, { "key": "client_id", "value": "{{peoClientId}}" }, { "key": "client_secret", "value": "{{peoClientSecret}}" }] } } },
    { "name": "GetGoogleAccessToken (GET with body)", "request": { "method": "GET", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"grant_type\": \"authorization_code\",\n  \"code\": \"{{googleAuthorizationCode}}\",\n  \"client_id\": \"{{googleClientId}}\",\n  \"client_secret\": \"{{googleClientSecret}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/GetGoogleAccessToken" } }
  ]
}